# JoyDM configuration — copy to `.env` (loaded automatically, no dotenv needed).

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080

DATABASE_PATH=./data/music.db
MUSIC_LIBRARY_PATH=./music-library
LOG_PATH=./logs

# Required when APP_ENV=production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
SESSION_TTL_HOURS=720

LOG_LEVEL=info

# Require a signed-in user for the library and streaming endpoints.
PRIVATE_MODE=true

# Future feature — not wired up in the MVP.
ALLOW_DOWNLOAD=false

# Metadata parsing workers during a scan (2-4 recommended).
SCAN_CONCURRENCY=3

# Run a library scan automatically a couple of seconds after boot.
SCAN_ON_STARTUP=false

# Failed login attempts allowed per IP per minute.
LOGIN_ATTEMPTS_PER_MINUTE=5
