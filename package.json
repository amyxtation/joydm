{
  "name": "joydm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JoyDM — a lightweight, self-hosted web-based music streaming player.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "scan": "node scripts/scan.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.1",
    "music-metadata": "^11.9.0"
  },
  "devDependencies": {
    "vite": "^5.4.10"
  }
}
